{
  "name": "@slyke/node-red-matter-bridge",
  "version": "0.13.0",
  "description": "Matter bridge nodes for Node-RED, maintained by Slyke with startup and device fixes",
  "author": "Sam Machin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slyke/node-red-matter-bridge.git"
  },
  "dependencies": {
    "@matter/main": "^0.16.10",
    "traverse": "^0.6.10"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "node-red"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "matter-bridge": "bridge.js",
      "matter-onofflight": "onofflight.js",
      "matter-onoffsocket": "onoffsocket.js",
      "matter-dimmablelight": "dimmablelight.js",
      "matter-fullcolorlight": "fullcolorlight.js",
      "matter-colortemplight": "colortemplight.js",
      "matter-contactsensor": "contactsensor.js",
      "matter-lightsensor": "lightsensor.js",
      "matter-temperaturesensor": "temperaturesensor.js",
      "matter-occupancysensor": "occupancysensor.js",
      "matter-pressuresensor": "pressuresensor.js",
      "matter-humiditysensor": "humiditysensor.js",
      "matter-genercswitch": "genericswitch.js",
      "matter-windowcovering": "windowcovering.js",
      "matter-thermostat": "thermostat.js",
      "matter-doorlock": "doorlock.js",
      "matter-fan": "fan.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "homepage": "https://github.com/Slyke/node-red-matter-bridge#readme",
  "bugs": {
    "url": "https://github.com/Slyke/node-red-matter-bridge/issues"
  },
  "contributors": [
    {
      "name": "Slyke",
      "url": "https://github.com/Slyke"
    }
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "*.js",
    "*.html",
    "devices/",
    "resources/",
    "examples/",
    "CHANGELOG.md"
  ]
}
